# Copy this file to ".env" and paste your own keys after the = signs.
# NEVER commit .env to GitHub (it is in .gitignore).

# Google AI Studio -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twilio console -> Account Info (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox WhatsApp number, with + (shown on the sandbox page)
TWILIO_WHATSAPP_FROM=+14155238886
# The "join xxxx-yyyy" words from the Twilio sandbox page
TWILIO_SANDBOX_JOIN=join example-words

# Your own WhatsApp number (with +91) to act as the planner of the demo workspace
DEMO_PLANNER_PHONE=

# How often (minutes) to remind people in demo mode, and how many times before telling the planner
REMINDER_MINUTES=2
MAX_REMINDERS=3
